VITE_BASE=/

# 接口地址（生产环境：统一走 chat.lycodeing.cn 路径代理，/api/v1 为后端统一前缀）
VITE_GLOB_API_URL=https://chat.lycodeing.cn/api/v1

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
